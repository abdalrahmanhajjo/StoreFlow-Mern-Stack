# Copy to .env and fill in real values. Never commit .env.

# Server (avoid 5000 on macOS — AirPlay Receiver squats on it)
PORT=5050
NODE_ENV=development

# Database — either a local MongoDB or an Atlas cluster.
# Atlas: URL-encode special characters in the password (@ -> %40).
# MONGO_URI=mongodb+srv://<user>:<encoded-password>@<cluster-host>/storeflow?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/storeflow

# Auth
JWT_ACCESS_SECRET=change-me

# Frontend origin (CORS + links in emails)
CLIENT_APP_URL=http://localhost:5175

# Outgoing email — Gmail API over HTTPS (works on hosts that block SMTP, like
# Render's free plan; sends straight from your own Gmail). See DEPLOY.md for
# how to create the OAuth credentials and mint a refresh token.
# Publish the OAuth consent screen ("In production") or the refresh token
# expires after 7 days. Leave these empty for local dev — codes print to the
# console instead.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=                # the Gmail address you authorized, e.g. you@gmail.com
GMAIL_SENDER_NAME=StoreFlow
